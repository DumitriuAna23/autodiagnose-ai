# ==============================
# AutoDiagnose AI backend
# ==============================

# Local development
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Keep your existing local PostgreSQL values:
# DB_USER=postgres
# DB_PASSWORD=your_local_password
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=autodiagnose

# Production later:
# APP_ENV=production
# FRONTEND_ORIGINS=https://your-frontend-domain.com
# COOKIE_SECURE=true
#
# Use "lax" when frontend and API are same-site.
# Use "none" only when frontend and API are on
# different sites, and only with HTTPS.
# COOKIE_SAMESITE=lax
#
# Most cloud PostgreSQL providers give one URL:
# DATABASE_URL=postgresql://...
